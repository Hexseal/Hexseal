#!/usr/bin/env bash
# Замок на отправку: не даёт уехать наружу тому, что наружу не должно.
#
# Ставится один раз:  git config core.hooksPath .githooks
# Проверить вручную:  .githooks/pre-push --check <база>..<голова>
#
# ⚠️ ЗАЧЕМ. Репозиторий публичный. После `git push` отозвать нельзя ничего:
# копии, кэши и зеркала живут своей жизнью. Единственный момент, когда ещё
# можно передумать, — вот этот. Замок ищет не «подозрительное вообще»
# (такое даёт ложные срабатывания и его отключают через неделю), а ровно
# те классы, на которых этот проект уже обжигался:
#
#   1. настоящие значения из локальных .env — сверяются с файлом, не по образцу;
#   2. личная почта владельца (он анонимен намеренно);
#   3. локальные пути машины;
#   4. чужие персональные данные — push-подписки людей;
#   5. закрытые ключи в файлах-контейнерах (.pem, id_rsa, .env целиком).
#
# Класс 1 — самый ценный: он не угадывает, а сравнивает с тем, что реально
# лежит в окружении. Ложных срабатываний у него не бывает по построению.

set -uo pipefail

RED=$'\033[0;31m'; YEL=$'\033[0;33m'; GRN=$'\033[0;32m'; OFF=$'\033[0m'
REPO_ROOT="$(git rev-parse --show-toplevel)"
FOUND=0

say_hit() {                     # $1 — что нашли, $2 — где
  FOUND=1
  printf '%s✗ %s%s\n    %s\n' "$RED" "$1" "$OFF" "$2"
}

# Собираем список коммитов, которые реально уедут.
# Пустая база (новая ветка на пустом remote) — берём всё от корня.
ranges=()
if [[ "${1:-}" == "--check" && -n "${2:-}" ]]; then
  ranges+=("$2")
else
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" =~ ^0+$ ]] && continue          # удаление ветки — нечего смотреть
    # Пустая база — новая ветка. Но есть второй случай, и он коварнее:
    # база названа, а объекта у нас нет. Так бывает после переписывания
    # истории — на той стороне ещё старая, у нас её уже нет. Разность с
    # несуществующим коммитом посчитать нельзя, и замок молча увидел бы
    # пустоту. Оба случая означают одно: смотреть надо ВСЮ ветку.
    if [[ "$remote_sha" =~ ^0+$ ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      ranges+=("$local_sha")
    else
      ranges+=("$remote_sha..$local_sha")
    fi
  done
fi
[[ ${#ranges[@]} -eq 0 ]] && exit 0

# Текст, который уедет: содержимое добавленных строк во всех коммитах диапазона.
payload="$(mktemp)"; names="$(mktemp)"
trap 'rm -f "$payload" "$names"' EXIT
# Только `git log`, не `git diff`: с одним номером вместо диапазона `git diff`
# сравнил бы историю с рабочим столом — это другой вопрос и другой ответ.
# Секрет, добавленный и позже убранный, в истории остаётся и уедет наружу,
# поэтому смотрим добавленные строки ВСЕХ коммитов, а не итоговые файлы.
for r in "${ranges[@]}"; do
  git log --format='%H%n%s%n%b' -p -U0 "$r" 2>/dev/null \
    | LC_ALL=C grep -aE '^(\+|[0-9a-f]{40}|[^+-])' >>"$payload"
  git log --format='' --name-only "$r" 2>/dev/null >>"$names"
done

# ── 1. Настоящие значения из окружения ───────────────────────────────────
# Не образец, а сверка с тем, что лежит на диске. Значения нигде не печатаем.
for envfile in "$REPO_ROOT"/.env "$REPO_ROOT"/.env.* "$REPO_ROOT"/relayer/.env.relayer "$REPO_ROOT"/frontend/.env.local; do
  [[ -f "$envfile" ]] || continue
  case "$envfile" in *.example) continue ;; esac
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    val="${line#*=}"; val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
    key="${line%%=*}"
    # Короткие и общеупотребительные значения пропускаем: они дают шум,
    # а не сигнал (true/false, 3000, localhost и подобное).
    [[ ${#val} -lt 24 ]] && continue
    # ⚠️ Замерено 12 августа: без двух отсечек ниже замок дал 13 срабатываний
    # на настоящей истории, и НИ ОДНО не было секретом — адреса контрактов,
    # публичные RPC, ссылка на сабграф, почта проекта. Замок, который воет на
    # пустом месте, отключают через неделю, и тогда он не поймает уже ничего.
    #
    # Отсечка первая: публичное по своей природе. Адрес контракта и ссылку
    # видно в обозревателе цепи — прятать их не от кого.
    case "$val" in
      http://*|https://*|mailto:*|0x????????????????????????????????????????) continue ;;
    esac
    # Отсечка вторая: секрет узнаём по имени или по форме. Имя — то, как
    # называют тайну; форма — сырой ключ (0x и 64 шестнадцатеричных, либо
    # те же 64 без приставки), даже если названо безобидно.
    is_secret=0
    case "$key" in
      *PRIVATE*|*SECRET*|*TOKEN*|*PASSWORD*|*PASSWD*|*MNEMONIC*|*SEED*|*_KEY|*_KEY_*|*APIKEY*) is_secret=1 ;;
    esac
    [[ "$val" =~ ^(0x)?[0-9a-fA-F]{64}$ ]] && is_secret=1
    [[ $is_secret -eq 0 ]] && continue
    if LC_ALL=C grep -aqF -- "$val" "$payload"; then
      say_hit "настоящее значение ${key} из $(basename "$envfile") уезжает наружу" \
              "оно лежит в вашем окружении и не должно попадать в коммит"
    fi
  done <"$envfile"
done

# ── 2. Личные строки ─────────────────────────────────────────────────────
# ⚠️ Личную почту и прочие «ищем вот это» здесь НЕ пишем. Замок уезжает
# наружу вместе с репозиторием: строка, вписанная сюда образцом для поиска,
# публикуется этим же push'ем. Замерено 13 августа — единственное совпадение
# по имени владельца во всей истории сидело внутри самого замка.
# Поэтому личные строки лежат рядом в файле, который git не отслеживает.
#
# Старое имя проекта (Signature404) не ищем намеренно: переименование —
# честная часть истории, а не утечка. Замок на него давал только шум.
NEEDLE_FILE="$REPO_ROOT/.githooks/private-needles"
if [[ -f "$NEEDLE_FILE" ]]; then
  while IFS= read -r needle; do
    [[ -z "$needle" || "$needle" == \#* ]] && continue
    if LC_ALL=C grep -aqF -- "$needle" "$payload"; then
      # Само значение не печатаем — вывод git попадает в логи и на экраны.
      say_hit "личная строка из .githooks/private-needles (${#needle} симв.)" \
              "проект ведётся анонимно — используйте проектную личность"
    fi
  done <"$NEEDLE_FILE"
else
  printf '%s… личных строк нет: создайте .githooks/private-needles (git его не видит)%s\n' "$YEL" "$OFF"
fi

# ── 3. Локальные пути машины ─────────────────────────────────────────────
# Тоже без литералов: имя пользователя — это и есть то, что мы прячем.
# Берём его у системы во время работы.
me="$(id -un 2>/dev/null || echo '')"
path_needles=("$HOME")
[[ -n "$me" ]] && path_needles+=("/home/$me" "/media/$me" "/mnt/$me" "/Users/$me")
declare -A seen_path=()
for needle in "${path_needles[@]}"; do
  [[ -z "$needle" || "$needle" == "/" ]] && continue
  [[ -n "${seen_path[$needle]:-}" ]] && continue   # $HOME часто совпадает с /home/<имя>
  seen_path["$needle"]=1
  if LC_ALL=C grep -aqF -- "$needle" "$payload"; then
    say_hit "локальный путь машины (${#needle} симв., начинается с $(printf '%.6s' "$needle")…)" \
            "он выдаёт имя пользователя — замените на ~ или относительный путь"
  fi
done

# ── 4. Чужие персональные данные ─────────────────────────────────────────
# Класс, который утренний аудит пропустил: это не «наш секрет», это данные
# двадцати шести человек, и решение за них принимаем не мы.
#
# Ищем НЕ названия полей: `p256dh` и `push_subscriptions` — это имена в нашем
# же коде, они там по делу (замерено: два срабатывания, оба на собственном
# коде). Ищем сами адреса устройств — их выдумать нельзя, они бывают только
# настоящие, и каждый принадлежит человеку.
device_re='https://(fcm\.googleapis\.com/fcm/send/|web\.push\.apple\.com/|updates\.push\.services\.mozilla\.com/wpush/)[A-Za-z0-9_:%-]{20,}'
if LC_ALL=C grep -aqE -- "$device_re" "$payload"; then
  say_hit "адрес устройства живого человека в подписке на уведомления" \
          "это чужие персональные данные — решение публиковать их не наше"
fi

# ── 5. Файлы-контейнеры секретов ─────────────────────────────────────────
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  case "$f" in
    *.pem|*.key|*id_rsa*|*.p12|*.keystore)
      say_hit "файл-контейнер ключа: ${f}" "такие файлы не публикуются" ;;
    .env|.env.local|.env.relayer|.env.vps|*/.env|*/.env.local)
      say_hit "файл окружения: ${f}" "публикуются только шаблоны .env.example" ;;
  esac
done <"$names"

if [[ $FOUND -eq 1 ]]; then
  printf '\n%sОТПРАВКА ОСТАНОВЛЕНА.%s\n' "$RED" "$OFF"
  printf 'Репозиторий публичный: после push отозвать нельзя ничего.\n'
  printf 'Уберите найденное и повторите. Если уверены, что это ложная тревога:\n'
  printf '  %sgit push --no-verify%s — и скажите вслух, почему.\n' "$YEL" "$OFF"
  exit 1
fi

printf '%s✓ замок отправки: чисто%s\n' "$GRN" "$OFF"
exit 0
