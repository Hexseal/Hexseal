pragma solidity ^0.8.20;

// ============================================================
// HEXSEAL — Treasury.sol
//
// Казна протокола. Принимает фикс-комиссии за создание сделок и
// распределяет их по лестнице: буфер банка арбитров → фаундейшн → резерв.
//
// Подставляется одной транзакцией FactoryFacet.setFeeRecipient(treasury).
// Фабрика, эскроу и доски не меняются: они платят на адрес, и им
// безразлично, кошелёк там или контракт.
//
// АДМИНИСТРАТОРА НЕТ. Ни одной функции только-для-владельца. Проценты —
// constant, изменить их нельзя ничем; ошибка в числах исправляется только
// новым контрактом и новым setFeeRecipient, что видно снаружи.
//
// ЦЕНА ЗАМЕНЫ. setFeeRecipient перенаправляет только БУДУЩИЙ доход.
// Накопленный reserveBalance остаётся в этом контракте. Тратится он отсюда
// двумя путями: topUpVault() — permissionless, без гейта ДАО, и только
// ровно на просадку банка (единственный расход резерва до появления ДАО,
// см. ниже); и withdrawReserve() — по заработанному порогу uniqueActiveUsers,
// а не по isDaoActive() (см. докстринг withdrawReserve — гейт здесь
// намеренно строже, чем у переключения долей, и ЧЕСТНЫЕ границы этой
// строгости — тоже там). Накопленный foundationOwed остаётся здесь же, но
// достаётся в любой момент через withdrawFoundation() — это не спорные
// деньги, а просто причитающееся, порог ДАО тут ни при чём.
// Миграционная функция потребовала бы того, кто имеет право её вызвать,
// то есть администратора — а это отменяет всё вышенаписанное. Принято
// осознанно: цена ошибки здесь — замороженный резерв, а не украденный.
// Нераспределённый остаток (то, что ещё не reserveBalance и не
// foundationOwed) при замене НЕ замораживается. Раздача трогает диамонд в
// ТРЁХ местах, и все три изолированы так, что провал ни одного из них не
// роняет лестницу целиком:
//   • сам вызов fundVault — сырой CALL с нулевым выходным буфером,
//     провал терпится и не ревертит раздачу (см. _fundVault);
//   • чтение getVaultBalance() — staticcall с газ-капом; провал читается
//     как «добирать нечего», ступень банка просто пропускается
//     (vaultShortfall() → 0, см. её докстринг);
//   • чтение isDaoActive() — staticcall с газ-капом; провал фиксирует
//     МЕНЬШУЮ из двух долей фаундейшна, FOUNDATION_BPS_POST_DAO = 20%
//     (см. foundationBps — направление деградации выбрано по стимулу).
// Поэтому всё, что выше текущего vaultShortfall, по-прежнему уходит в
// фаундейшн и в резерв каждым следующим distribute(). Заперт остаётся
// только хвост размером не больше vaultShortfall (то есть не больше
// VAULT_TARGET, 500 USDC), и только пока getVaultBalance() ЖИВ и
// показывает просадку: если умер и он, шортфолл читается нулём и не
// запирается вообще ничего. Хвост не накапливается от вызова к вызову —
// следующий distribute() пробует ровно ту же сумму и упирается в тот же
// лимит. Он не потерян и не украден — просто бессрочно pending на старом
// контракте.
//
// ДОВЕРИЕ, КОТОРОЕ КАЗНА ОБЯЗАНА ОКАЗАТЬ. Банк арбитров стоит ПЕРВЫМ в
// лестнице сознательно — без него арбитраж останавливается. Но опустошение
// банка управляется владельцем диамонда через setRewardPerDispute (onlyOwner
// в ArbiterRegistryFacet): пока vaultShortfall не нулевой, весь доход
// приоритетно идёт туда. Значит, владелец диамонда, договорившись со своим
// арбитром, теоретически может держать банк искусственно сухим (завысив
// rewardPerDispute) и таким образом перетягивать через него выручку казны
// вместо честной доли фаундейшна/резерва. Казна этого не видит и не может
// проверить — она обязана кому-то верить, и это осознанный выбор, а не
// недосмотр: альтернатива (казна сама решает, сколько банку «на самом деле»
// нужно) означала бы, что казна знает бизнес-логику арбитража лучше самого
// диамонда, что не так.
//
// Тот же счёт предъявлен ступени банка и БЕЗ злого умысла, и это второй
// принятый остаточный риск. distribute() не проверяет, что банк УЧЁЛ
// присланное: _fundVault возвращает spent — сколько USDC реально покинули
// казну, — и это всё, что distribute() знает. Сломанный (не обязательно
// враждебный: достаточно неудачного апгрейда фасета) fundVault, который
// честно принимает transferFrom и забывает записать прирост в собственный
// счётчик, съедает доход МОЛЧА. Замерено ревью: десять партий комиссий по
// 200 USDC, после каждой distribute() — диамонд поглотил все 2000 USDC,
// foundationOwed 0, reserveBalance 0, счётчик банка ноль, и каждый вызов
// честно эмитил Distributed(200 USDC, 0, 0), то есть снаружи выглядел
// успешной работой. У topUpVault() симметричная проверка ЕСТЬ
// (VaultDidNotGrow), здесь её намеренно нет — реверт на таком постусловии
// замуровал бы всю раздачу, то есть вернул бы через другую дверь ровно ту
// поломку, от которой ступени 2 и 3 отвязывали (см. комментарий в теле
// distribute()). Потолок потерь — VAULT_TARGET (500 USDC) за каждый вызов
// distribute(), то есть при мелких партиях весь доход; резерв и уже
// начисленное фаундейшну distribute() не трогает вовсе.
//
// С появлением withdrawReserve() тот же счёт предъявлен резерву — и здесь
// доверие куда острее, потому что деньги уходят НАРУЖУ. Гейт
// getUniqueActiveUsers() >= DAO_THRESHOLD ДЕЙСТВИТЕЛЬНО держит против
// РУЧНОГО ФЛАГА isDaoActive() (проверено: activateDAO() + setDAOAddress
// без заработанного порога ревертит DaoNotEarned, граница ровно на
// DAO_THRESHOLD). Но это не защита от владельца диамонда вообще, и выдавать
// её за такую нельзя: казна читает счётчик из АПГРЕЙДИМОГО контракта и не
// может быть строже его владельца. Ревью нашло ТРИ действующих (не
// гипотетических) пути того же владельца к тому же результату — казна их
// не видит и не может отличить от честного роста:
//
//   (a) diamondCut(Replace, [селектор getUniqueActiveUsers()], evilFacet) —
//       одна onlyOwner-транзакция подменяет счётчик на функцию, всегда
//       возвращающую DAO_THRESHOLD. Замерено: 283 891 газа, на Base это
//       меньше пяти центов. DiamondCutFacet.diamondCut гейтится только
//       OwnershipLib.enforceIsContractOwner() (DiamondProxy.sol:319),
//       replaceFunctions пускает подменить ЛЮБОЙ селектор ЛЮБЫМ фасетом
//       (DiamondProxy.sol:173-189) — ни таймлока, ни списка неприкасаемых
//       селекторов нет.
//
//   (b) Накрутка счётчика ЧЕСТНЫМИ сделками. ReputationFacet начисляет
//       uniqueActiveUsers на каждый свежий адрес при завершённой сделке от
//       10 USDC (ReputationFacet.sol:308-312), по два уникальных адреса на
//       сделку — 50 000 сделок на весь порог. Полный цикл сделки (создание →
//       финансирование → активация → сдача → релиз) замерен на настоящем
//       диамонде (test/TreasuryIntegration.t.sol) — 1 118 150 газа; итог —
//       3-17 тыс. долларов газа против 192 тыс. долларов резерва, и капитал
//       не расходуется: эскроу-депозит рециклируется между сделками.
//       Здесь раньше стояло, что у владельца есть ещё и рычаг
//       FactoryFacet.setRegionFee(region, 0) (onlyOwner, без нижней границы,
//       FactoryFacet.sol:249-253), обнуляющий «единственную реальную
//       стоимость» такой накрутки. Это ЗАНИЖАЛО риск, а не завышало:
//       регион-комиссия вообще не является стоимостью. Она уходит НА КАЗНУ,
//       и ближайший же distribute() превращает её в foundationOwed (доля
//       фаундейшна) и в резерв — то есть ровно в те деньги, ради которых
//       атака и делается. Атакующий-владелец возвращает себе как минимум
//       резервную долю уплаченного (её открывает к выводу сама эта атака), а
//       если фаундейшн и владелец ключа — одна сторона (сегодня это так),
//       то все 100%. Значит setRegionFee(_, 0) для накрутки не нужен вовсе,
//       и настоящая цена пути (b) — только ГАЗ.
//
//   (c) diamondCut(ПУСТОЙ массив катов, _init = любой контракт, _calldata) —
//       одна onlyOwner-транзакция, которая не монтирует и не снимает НИЧЕГО,
//       а делает delegatecall на произвольный код и пишет
//       ReputationStorage.data().uniqueActiveUsers = 100_000 прямо в
//       хранилище диамонда. Цикл по катам (DiamondProxy.sol:140) на пустом
//       массиве просто не исполняется, а initializeDiamondCut
//       (DiamondProxy.sol:248-261) выполняется всё равно: на _init нет ни
//       таймлока, ни белого списка, ни проверки — только «есть код».
//       Замерено на настоящем диамонде: 31 717 газа, в девять раз дешевле
//       (a). И, в отличие от (a), в loupe НЕ ВИДНО НИЧЕГО: facets() до и
//       после побайтово идентичны (сверено по keccak), состав фасетов и
//       селекторов не менялся, счётчик не подменён — настоящий
//       ReputationFacet честно возвращает 100 000 из перезаписанного слота.
//       Мониторинг по фасетам и селекторам этот путь не поймает в принципе;
//       снаружи виден только сам факт события DiamondCut с непустым _init.
//
// Разница с одним только isDaoActive() — в цене и заметности атаки, а не в
// принципиальной невозможности: (a) стоит копейки и виден любому, кто читает
// diamondCut-события; (b) стоит на два порядка меньше самого резерва (и то
// в основном возвратного) и маскируется под обычный поток сделок; (c) стоит
// дешевле обеих и не оставляет следа ни в одном loupe-срезе. Ни одного из
// трёх казна предотвратить не может — она читает состояние диамонда, а не
// контролирует его. Будущему читателю: не ищите враждебный фасет — по пути
// (c) его нет.
// ============================================================

interface IUSDC {
    function transfer(address to, uint256 amount) external returns (bool);
    function approve(address spender, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

interface IHexsealDiamond {
    function fundVault(uint256 amount) external;
    function getVaultBalance() external view returns (uint256);
    function isDaoActive() external view returns (bool);
    function getUniqueActiveUsers() external view returns (uint256);
    function getDAOAddress() external view returns (address);
}

contract Treasury {

    // -------- КОНСТАНТЫ (изменить невозможно ничем) --------

    /// Цель буфера банка арбитров. Величина абсолютная по природе: это запас
    /// на N дотаций, а не доля дохода. Банк не переполняется и не сохнет.
    uint256 public constant VAULT_TARGET = 500_000_000; // 500 USDC (6 decimals)

    uint256 public constant FOUNDATION_BPS_PRE_DAO  = 7_000; // 70%
    uint256 public constant FOUNDATION_BPS_POST_DAO = 2_000; // 20%
    uint256 public constant DAO_THRESHOLD           = 100_000; // uniqueActiveUsers

    uint256 private constant BPS = 10_000;

    /// Газ-кап на одно чтение из диамонда (_readDiamondWord). Через него
    /// идут оба чтения, от которых зависит раздача: getVaultBalance() и
    /// isDaoActive().
    ///
    /// Кап нужен не ради экономии, а потому что работу на стороне
    /// вызываемого оплачивает НАША транзакция. Фасет, который перед
    /// возвратом раздувает память на 8 МБ, стоит около 135 млн газа — без
    /// капа distribute() перестал бы влезать в блок и замерзал бы навсегда,
    /// формально ничего не ревертя.
    ///
    /// 100 000 выбрано так. Честное чтение — это фоллбэк диамонда,
    /// delegatecall в фасет и один-два SLOAD, порядка 10 000 газа даже на
    /// холодную. Десятикратный запас оставляет место любому разумному
    /// будущему фасету (скажем, считающему банк из нескольких слотов) и при
    /// этом жёстко ограничивает худший случай: два чтения за distribute() —
    /// не больше 200 000 газа сверху, что на фоне лимита блока незаметно.
    uint256 private constant DIAMOND_VIEW_GAS = 100_000;

    // -------- IMMUTABLE --------

    address public immutable usdc;
    address public immutable diamond;
    /// Один адрес. Что происходит за ним — команда, инвестор, инфраструктура —
    /// казна не знает и знать не должна: это бумажный договор, не код.
    address public immutable foundation;

    // -------- ХРАНИЛИЩЕ --------

    /// Сколько из лежащего здесь USDC уже отнесено в резерв.
    uint256 public reserveBalance;

    /// Сколько причитается фаундейшну и ещё не забрано через
    /// withdrawFoundation().
    ///
    /// Выплата фаундейшну вытягивающая, а не «в момент распределения»: у
    /// USDC есть чёрный список Circle, и попадание туда адреса фаундейшна
    /// ревертило бы transfer прямо внутри distribute() — а вместе с ним и
    /// всю раздачу, навсегда, потому что foundation immutable и обойти
    /// нечем. Долг просто копится, банк и резерв при этом продолжают
    /// наполняться как обычно; это тот же самый класс поломки, что уже
    /// изолирован на ступени банка через _fundVault — ни одна ступень
    /// лестницы не имеет права замуровать остальные.
    uint256 public foundationOwed;

    /// Вместе reserveBalance и foundationOwed — это всё состояние УЧЁТА
    /// денег. Не всё состояние контракта вообще: третья storage-переменная
    /// есть — _status стража реентранси (объявлен ниже), но денег он не
    /// считает и между транзакциями всегда равен NOT_ENTERED.
    /// Всё остальное выводится из фактического баланса:
    /// pendingDistribution() = balanceOf(казна) − reserveBalance −
    /// foundationOwed. USDC, присланный сюда напрямую кем угодно, просто
    /// увеличит нераспределённую часть и попадёт в ближайший distribute() —
    /// учёт не сломает ни то, ни другое.

    // -------- РЕЕНТРАНСИ --------
    //
    // Простейший страж в стиле ReentrancyGuard из Agreement.sol, без внешних
    // зависимостей. У Agreement обычный конструктор подменяется клоном и
    // initialize(), поэтому там _status инициализируется отдельным методом;
    // у Treasury конструктор ровно один и вызывается один раз — инициализация
    // прямо в нём, отдельный метод здесь был бы лишней поверхностью.

    uint256 private constant NOT_ENTERED = 1;
    uint256 private constant ENTERED = 2;
    uint256 private _status;

    modifier nonReentrant() {
        if (_status == ENTERED) revert Reentrancy();
        _status = ENTERED;
        _;
        _status = NOT_ENTERED;
    }

    // -------- СОБЫТИЯ --------

    event Distributed(uint256 toVault, uint256 toFoundation, uint256 toReserve);
    event VaultToppedUp(uint256 amount);
    event ReserveWithdrawn(address indexed dao, uint256 amount);
    event FoundationWithdrawn(uint256 amount);

    // -------- ОШИБКИ --------

    error ZeroAddress();
    error NoCode();
    error NothingToDistribute();
    error DistributeFirst();
    error TransferFailed();
    error ApproveFailed();
    error Reentrancy();
    error NothingOwed();
    error VaultAtTarget();
    error ReserveEmpty();
    error VaultFundingFailed();
    error VaultDidNotGrow();
    error DaoNotEarned();
    error DaoAddressUnset();
    error NotDao();
    error InvalidAmount();

    constructor(address usdc_, address diamond_, address foundation_) {
        if (usdc_ == address(0) || diamond_ == address(0) || foundation_ == address(0)) revert ZeroAddress();
        // Оба внешних контракта обязаны иметь код: вызов к адресу без кода в
        // EVM возвращает УСПЕХ. Для диамонда это значило бы, что approve
        // прошёл, fundVault «удался», а деньги остались бы на казне, числясь
        // ушедшими в банк. Для USDC — что balanceOf/transfer молча вернут
        // пустоту вместо провала, и вся бухгалтерия контракта потеряет опору.
        if (usdc_.code.length == 0) revert NoCode();
        if (diamond_.code.length == 0) revert NoCode();
        usdc       = usdc_;
        diamond    = diamond_;
        foundation = foundation_;
        _status    = NOT_ENTERED;
    }

    // -------- ЛЕСТНИЦА --------

    /// @notice Распределить всё, что накопилось с прошлого раза.
    ///
    /// Вызвать может кто угодно. Это не упущение: у ERC-20 нет колбэка, о
    /// поступлении комиссии казна узнать в момент поступления не может.
    ///
    /// ЧЕСТНО о том, что даёт право вызова. Раньше здесь было написано, что
    /// «ни момент, ни вызывающий на дележ не влияют» — это было неправдой в
    /// обе стороны. МОМЕНТ влияет: доля первой ступени равна vaultShortfall()
    /// в блоке вызова, а он двигается независимо от казны (выплаты арбитрам,
    /// onlyOwner setRewardPerDispute). Чего вызывающий сделать НЕ может — это
    /// поменять, КТО платит за банк. До гейта DistributeFirst он мог: вызов
    /// topUpVault() перед distribute() перекладывал ступень банка с дохода
    /// на резерв, и замерено, что на одной просадке это двигало до 210 USDC
    /// из резерва в фаундейшн (см. докстринг topUpVault). Теперь очередь
    /// ступеней жёсткая: доход разбирается первым, резерв добивает банк
    /// только после. Получатели, правило расчёта и порядок ступеней от
    /// вызывающего не зависят вовсе — преимущества право вызова не даёт.
    function distribute() external nonReentrant {
        uint256 pending = pendingDistribution();
        if (pending == 0) revert NothingToDistribute();

        // Этот страж защищает ДЕНЬГИ, не только телеметрию: без него казна
        // становится неплатёжеспособной. Измерено ревью (атакующий реентерит
        // distribute() из fundVault() ДО собственного pull, а на самом
        // глубоком уровне отчитывается о полном банке): вложенный вызов,
        // увидевший схлопнувшуюся vaultShortfall() == 0, размечает СТО
        // ПРОЦЕНТОВ своего pending в reserveBalance/foundationOwed —
        // включая деньги, которые уровень выше УЖЕ разрешил (approve) к
        // списанию и которые диамонд стянет сразу после возврата из этого
        // вложенного вызова. Замерено на
        // глубине 2-4 (результат одинаковый): pending 1 000 000 000, реально
        // стянуто банком 500 000 000, размечено 1 000 000 000 — казна
        // неплатёжеспособна на величину до VAULT_TARGET (500 000 000).
        //
        // Отдельно (и это по-прежнему так): вытянуть больше денег, чем было
        // в исходном ВНЕШНЕМ pending, вложенность не может — замерено на
        // глубине 6, разных порядках и 5000 USDC уже размеченных денег:
        // максимум извлечения всегда VAULT_TARGET, потому что approve()
        // каждого уровня ограничен min(vaultShortfall(), pending) <=
        // VAULT_TARGET и сбрасывается в 0 при разматывании стека. Это предел
        // на кражу сверх лимита, а не платёжеспособность — платёжеспособность
        // держит только nonReentrant.
        //
        // Если вместо этого реентрант тянет свой pull ДО попытки реентранси
        // (vaultShortfall() при этом не схлопывается), деньгам ничего не
        // грозит — но замерено четыре события Distributed с суммарным
        // toVault 2 000 000 000 вместо одного с нулём: страж вдобавок не
        // даёт задвоить сам факт исполнения тела distribute() за один
        // внешний вызов.
        uint256 toVault = vaultShortfall();
        if (toVault > pending) toVault = pending;
        uint256 rest = pending - toVault;
        uint256 toFoundation = (rest * foundationBps()) / BPS;

        // Резерв — весь остаток. Считаем вычитанием, а не второй долей: так
        // ни один цент не может потеряться на округлении.
        uint256 toReserve = rest - toFoundation;

        if (toReserve > 0)    reserveBalance += toReserve;
        if (toFoundation > 0) foundationOwed += toFoundation;

        // Ступень 1. Буфер банка арбитров — до цели и ни центом больше.
        // Провал этой ступени (казну заменили и диамонд её больше не
        // пускает в fundVault, гигантский revert-payload и т.п.) не должен
        // рушить ступени 2 и 3 — см. _fundVault.
        uint256 spent = 0;
        if (toVault > 0) (, spent) = _fundVault(toVault);

        // Постусловия «банк РЕАЛЬНО учёл прирост» здесь НЕТ, и это не
        // недосмотр, а обратная сторона той же развязки. У topUpVault() такая
        // проверка есть (VaultDidNotGrow) и обязана быть: там резерв уже
        // списан, и реверт — единственный способ вернуть списание. Здесь
        // реверт означал бы, что сломанный банк ЗАМУРОВЫВАЕТ всю раздачу —
        // ровно ту поломку, от которой ступени 2 и 3 отвязывали выше, только
        // через другую дверь. Поэтому spent участвует только в событии.
        // Цена решения замерена и записана в шапке файла («ДОВЕРИЕ, КОТОРОЕ
        // КАЗНА ОБЯЗАНА ОКАЗАТЬ»): молчаливая потеря до VAULT_TARGET за
        // вызов, при мелких партиях — всего дохода. Она не спрятана.
        emit Distributed(spent, toFoundation, toReserve);
    }

    // -------- ДОБИВКА БАНКА --------

    /// @notice Добить банк арбитров из резерва.
    ///
    /// Единственный расход резерва до появления ДАО. Вызвать может кто угодно,
    /// но перевод происходит ТОЛЬКО при просадке банка ниже цели, ТОЛЬКО на
    /// недостающую сумму (min(просадка, резерв) в блоке вызова) и ТОЛЬКО
    /// когда весь пришедший доход уже разобран distribute().
    ///
    /// ЧЕСТНО о том, что даёт право вызова. Раньше здесь было написано, что
    /// выбор момента вызывающему «НИЧЕГО не даёт». Это было неправдой, и
    /// цена неправды измерена. Вызывающий выбирает МОМЕНТ и тем самым
    /// косвенно влияет на сумму (вызов сразу после крупной выплаты арбитру
    /// двигает больше, чем вызов до неё) — это осталось. Но он влиял и на
    /// то, КТО платит за банк, а вот это уже двигало деньги между
    /// получателями. Замерено на идентичном старте (резерв 300 USDC, банк
    /// просел на 500, пришло 1000 USDC): distribute() первым — резерв 450,
    /// фаундейшн 1050; topUpVault() первым — резерв 240, фаундейшн 1260.
    /// 210 USDC переехало от перестановки двух открытых вызовов, по формуле
    /// Δ = foundationBps × S, где S — сколько за банк заплатил резерв.
    /// Повторяемо на каждой просадке, и стимул выбирать второй порядок есть
    /// у самого фаундейшна — то есть на практике банк финансировался бы
    /// ВСЕГДА из резерва, а первая ступень лестницы стала бы декоративной.
    /// Гейт DistributeFirst ниже это закрывает.
    ///
    /// Само состояние, по которому это правило считает (vaultShortfall, то
    /// есть текущий getVaultBalance() диамонда), двигается владельцем
    /// диамонда через onlyOwner setRewardPerDispute в ArbiterRegistryFacet —
    /// см. «ДОВЕРИЕ, КОТОРОЕ КАЗНА ОБЯЗАНА ОКАЗАТЬ» в шапке файла. Там это
    /// доверие описано только для БУДУЩЕГО дохода; topUpVault распространяет
    /// тот же рычаг на уже НАКОПЛЕННЫЙ резерв: владелец, осушающий банк между
    /// вызовами (или просто держащий его искусственно сухим), может вынести
    /// весь резерв за столько вызовов, сколько раз VAULT_TARGET укладывается
    /// в резерв (каждый вызов двигает не больше VAULT_TARGET) — тот же
    /// осознанный компромисс, что и в distribute(), просто на большую ставку
    /// (весь накопленный резерв, а не только будущий доход).
    ///
    /// Покрывает и наплыв споров, и дотацию нижней границы на мелких спорах:
    /// обе ситуации проявляются одинаково — как просадка банка.
    function topUpVault() external nonReentrant {
        // Резерв платит за банк только после того, как разобран доход.
        // Без этого условия порядок вызова двух открытых функций решал бы,
        // кто финансирует банк: замерено, что вызов topUpVault() перед
        // distribute() перекладывал до 210 USDC за раунд из резерва в
        // фаундейшн, а стимул выбирать такой порядок есть у самого
        // фаундейшна. Спека ставит доход первой ступенью лестницы — это
        // условие делает так на самом деле, а не на словах.
        //
        // Проверка стоит ПЕРВОЙ, до вычисления просадки, чтобы порядок
        // отказов был предсказуем: «сначала разбери доход» звучит раньше,
        // чем «банк и так полон». Тупика она не создаёт: distribute()
        // размечает ВЕСЬ pending, а ступень банка внутри него тратит ровно
        // столько, сколько тот же _fundVault потратил бы отсюда, — то есть
        // после distribute() нераспределённое равно нулю всегда, когда
        // topUpVault() вообще мог бы сработать (если банк не берёт деньги,
        // topUpVault() и сам ревертит VaultFundingFailed). Обратная сторона
        // честно: посторонний может отложить topUpVault() на один блок,
        // прислав казне пыль USDC, — пыль делает pending ненулевым. Лечится
        // тем же distribute(), открытым для кого угодно; деньги при этом
        // никуда не двигаются.
        if (pendingDistribution() != 0) revert DistributeFirst();

        uint256 shortfall = vaultShortfall();
        if (shortfall == 0) revert VaultAtTarget();

        uint256 amount = shortfall > reserveBalance ? reserveBalance : shortfall;
        if (amount == 0) revert ReserveEmpty();

        // Здесь и в постусловии ниже getVaultBalance() читается ОБЫЧНЫМ
        // типизированным вызовом, а не через _readDiamondWord — намеренно.
        // Деградация нужна там, где провал чтения замуровывает раздачу
        // навсегда (distribute); topUpVault же и так «всё или ничего», его
        // реверт ничего не запирает, а тихо продолжать здесь после
        // непрочитанного баланса было бы хуже реверта: резерв уже списан.
        // До этой строки поток вообще не доходит, если чтение мертво —
        // vaultShortfall() выше вернёт 0 и вызов упадёт на VaultAtTarget.
        uint256 vaultBefore = IHexsealDiamond(diamond).getVaultBalance();

        // Резерв убывает ДО внешнего вызова, а vaultShortfall() ниже —
        // размеченная только частично величина (в отличие от distribute(),
        // который перед вызовом банка размечает ВЕСЬ pending). Без
        // nonReentrant реентрант увидел бы уменьшенный reserveBalance при
        // неизменившемся vaultShortfall() (сам банк ещё не пополнился) и
        // списал бы резерв второй раз на тот же самый недостаток.
        reserveBalance -= amount;
        (bool ok, uint256 spent) = _fundVault(amount);
        // Всё или ничего — и это НАМЕРЕННО противоположно поведению distribute().
        // Там провал первой ступени терпится, иначе замена казны через
        // setFeeRecipient замуровала бы весь нераспределённый остаток. Здесь
        // терпеть нельзя: резерв уже списан, и молчаливый провал означал бы,
        // что деньги ушли из резерва, не дойдя до банка. Реверт возвращает
        // списание вместе со всей транзакцией.
        if (!ok || spent != amount) revert VaultFundingFailed();

        // spent == amount доказывает только то, что USDC ПОКИНУЛИ казну —
        // не то, что банк их УЧЁЛ. Это два разных факта: сломанный (не
        // обязательно враждебный — например, при будущем апгрейде фасета)
        // fundVault может честно принять transferFrom и забыть записать
        // прирост в собственном счётчике. Проверяем отдельно, что
        // getVaultBalance() вырос хотя бы на amount — «хотя бы», а не
        // «ровно», потому что другой (в том числе будущий) fundVault вправе
        // начислить БОЛЬШЕ, чем реально стянул (например, доложить что-то от
        // себя поверх запрошенного) — точное равенство запретило бы такой
        // фасет без веской причины.
        uint256 vaultAfter = IHexsealDiamond(diamond).getVaultBalance();
        if (vaultAfter < vaultBefore + amount) revert VaultDidNotGrow();

        emit VaultToppedUp(amount);
    }

    // -------- ВЫХОД РЕЗЕРВА К ДАО --------

    /// @notice Вывести резерв в адрес ДАО. Только ДАО, только по ЗАРАБОТАННОМУ
    /// порогу.
    ///
    /// Гейт здесь намеренно строже, чем у переключения долей, и вот почему.
    /// isDaoActive() истинна при ЛЮБОМ из двух условий: ручной флаг владельца
    /// (daoActiveManual) ИЛИ заработанный порог уникальных пользователей.
    /// Владелец диамонда может выставить daoAddress на свой кошелёк и включить
    /// ручной флаг — то есть по isDaoActive() резерв выводился бы по его
    /// решению. Поэтому здесь спрашивается только uniqueActiveUsers.
    ///
    /// Асимметрия не случайна: раннее переключение долей УМЕНЬШАЕТ долю
    /// фаундейшна, злоупотреблять им себе дороже, и мягкого гейта достаточно.
    /// Вывод резерва приносит выгоду тому, кто его делает, поэтому здесь гейт
    /// строже: РУЧНОЙ флаг (activateDAO()) сам по себе вывод больше не
    /// открывает — это проверенное и настоящее свойство (граница проверена
    /// ровно на DAO_THRESHOLD).
    ///
    /// Но это НЕ защита от владельца диамонда вообще, и выдавать её за такую
    /// не нужно: getUniqueActiveUsers() читается из АПГРЕЙДИМОГО диамонда,
    /// а значит казна не может быть строже его владельца. Ревью нашло два
    /// действующих (не гипотетических) пути того же владельца к тому же
    /// результату — diamondCut на сам счётчик и обнуление стоимости накрутки
    /// через setRegionFee(_, 0) — оба разобраны в шапке файла, раздел
    /// «ДОВЕРИЕ, КОТОРОЕ КАЗНА ОБЯЗАНА ОКАЗАТЬ». Разница с isDaoActive() — в
    /// стоимости и заметности атаки, а не в принципиальной невозможности.
    function withdrawReserve(uint256 amount) external nonReentrant {
        // Проверка порога — до проверки адреса намеренно: даже если адрес ещё
        // не выставлен, ответ обязан быть "ДАО не заработано", а не "адреса
        // нет" — иначе снаружи может показаться, что вывод сразу открылся бы
        // одним только setDAOAddress, без реального порога.
        if (IHexsealDiamond(diamond).getUniqueActiveUsers() < DAO_THRESHOLD) revert DaoNotEarned();

        // Адрес ДАО по умолчанию address(0) (см. ArbiterRegistryStorage),
        // пока владелец диамонда не вызовет setDAOAddress. Настоящий USDC
        // ревертит на переводе в ноль — без явной проверки здесь отказ
        // выглядел бы как голый реверт токена без собственной ошибки.
        address dao = IHexsealDiamond(diamond).getDAOAddress();
        if (dao == address(0)) revert DaoAddressUnset();
        if (msg.sender != dao) revert NotDao();
        if (amount == 0) revert InvalidAmount();

        // Берём меньшее из запрошенного и наличного, а НЕ ревертим при нехватке.
        // Причина не в удобстве: резерв тратят двое, и один из них —
        // topUpVault() — открыт для кого угодно. При реверте любой посторонний
        // мог бы срывать вывод ДАО, вызывая topUpVault() первым: тот законно
        // уменьшил бы резерв, и транзакция ДАО падала бы на вычитании. Обрезка
        // делает вывод устойчивым к такому опережению. Она же не даёт зацепить
        // нераспределённые деньги: toSend ограничен reserveBalance, а не
        // фактическим balanceOf(казна).
        uint256 toSend = amount > reserveBalance ? reserveBalance : amount;
        if (toSend == 0) revert ReserveEmpty();

        reserveBalance -= toSend;
        if (!IUSDC(usdc).transfer(dao, toSend)) revert TransferFailed();

        // В событии — фактически отправленное, а не запрошенное.
        emit ReserveWithdrawn(dao, toSend);
    }

    // -------- ВЫВОД ФАУНДЕЙШНА --------

    /// @notice Забрать начисленное фаундейшну.
    ///
    /// Вызвать может кто угодно — деньги всё равно уходят только на
    /// immutable-адрес фаундейшна, поэтому право вызова ничего не решает, а
    /// открытость означает, что сторонний может «протолкнуть» выплату, если
    /// самому фаундейшну лень или недосуг.
    function withdrawFoundation() external nonReentrant {
        uint256 amount = foundationOwed;
        if (amount == 0) revert NothingOwed();
        foundationOwed = 0;
        if (!IUSDC(usdc).transfer(foundation, amount)) revert TransferFailed();
        emit FoundationWithdrawn(amount);
    }

    // -------- ВЬЮХИ --------

    /// Сколько лежит на казне сверх того, что уже размечено (резерв плюс
    /// причитающееся фаундейшну).
    function pendingDistribution() public view returns (uint256) {
        uint256 balance = IUSDC(usdc).balanceOf(address(this));
        uint256 earmarked = reserveBalance + foundationOwed;
        return balance > earmarked ? balance - earmarked : 0;
    }

    /// Сколько банку арбитров не хватает до цели.
    ///
    /// Провал чтения — НЕ реверт, а 0: «добирать нечего». Ступень банка
    /// просто пропускается, и лестница продолжает работать — доход целиком
    /// уходит в фаундейшн и в резерв. Обычный типизированный вызов через
    /// фоллбэк здесь недопустим: снесённый или сломанный селектор
    /// getVaultBalance() ронял бы и distribute(), и topUpVault(), то есть
    /// замораживал бы 100% нераспределённого И всего будущего дохода —
    /// вместо хвоста размером с VAULT_TARGET, который обещает шапка файла.
    /// Это не гипотетика: ArbiterRegistryFacet апгрейдился около семи раз за
    /// три месяца, а восемь скриптов в script/ делают FacetCutAction.Remove.
    function vaultShortfall() public view returns (uint256) {
        (bool ok, uint256 balance) = _readDiamondWord(IHexsealDiamond.getVaultBalance.selector);
        if (!ok) return 0;
        return balance >= VAULT_TARGET ? 0 : VAULT_TARGET - balance;
    }

    /// Доля фаундейшна в текущем режиме.
    ///
    /// Гейт мягкий (isDaoActive учитывает и ручной флаг владельца) намеренно:
    /// раннее переключение УМЕНЬШАЕТ долю фаундейшна, то есть злоупотреблять
    /// им себе дороже. У withdrawReserve() стимул обратный (ранняя ручная
    /// активация ДАО там, наоборот, ОТКРЫВАЛА бы вывод по решению владельца) —
    /// поэтому её гейт нарочно другой: не isDaoActive(), а напрямую
    /// getUniqueActiveUsers() >= DAO_THRESHOLD, который не переключается одним
    /// ручным флагом. Это НЕ защита от владельца диамонда вообще — см.
    /// докстринг withdrawReserve и шапку файла («ДОВЕРИЕ, КОТОРОЕ КАЗНА
    /// ОБЯЗАНА ОКАЗАТЬ») про три действующих пути того же владельца обойти и
    /// этот гейт.
    ///
    /// Провал чтения — НЕ реверт, а FOUNDATION_BPS_POST_DAO (20%), МЕНЬШАЯ
    /// из двух долей. Направление деградации выбрано по стимулу, а не
    /// «безопасным по умолчанию»: при деградации в 70% у владельца диамонда
    /// появился бы рычаг «сломай isDaoActive() одним diamondCut и навсегда
    /// зафиксируй себе бóльшую долю». При 20% ломать чтение ему же дороже.
    /// Это та же асимметрия стимулов, на которой уже стоит гейт
    /// withdrawReserve() (см. её докстринг): там, где злоупотребление
    /// невыгодно самому злоупотребляющему, отдельную защиту можно не строить.
    function foundationBps() public view returns (uint256) {
        (bool ok, uint256 daoActive) = _readDiamondWord(IHexsealDiamond.isDaoActive.selector);
        if (!ok) return FOUNDATION_BPS_POST_DAO;
        return daoActive != 0
            ? FOUNDATION_BPS_POST_DAO
            : FOUNDATION_BPS_PRE_DAO;
    }

    // -------- ВНУТРЕННЕЕ --------

    /// Читает из диамонда ОДНО 32-байтное слово, не давая вызываемому ни
    /// заревертить нашу транзакцию, ни сжечь наш газ, ни залить нашу память.
    ///
    /// Та же модель угроз, что у _fundVault, распространённая на ЧТЕНИЯ:
    /// владелец диамонда может смонтировать враждебный или просто сломанный
    /// фасет, а может и вовсе снести селектор. Типизированный вызов через
    /// фоллбэк в этом случае ревертит и утаскивает за собой всю раздачу —
    /// см. докстринги vaultShortfall() и foundationBps(), где расписано, во
    /// что именно это обходится каждому из двух чтений.
    ///
    /// Три ограничения разом:
    ///   • staticcall — вызываемый не может ни менять состояние, ни
    ///     реентерить что-либо пишущее;
    ///   • выходной буфер ровно 0x20 — EVM не скопирует в нашу память
    ///     больше 32 байт, чем бы ни ответил вызываемый (тот же приём, что
    ///     нулевой буфер в _fundVault);
    ///   • газ ограничен DIAMOND_VIEW_GAS — см. константу.
    ///
    /// Ответ короче слова считается провалом: успех с пустым returndata
    /// (например, вызов к адресу, у которого код исчез) иначе выдал бы за
    /// прочитанное значение содержимое неинициализированной памяти.
    function _readDiamondWord(bytes4 selector) private view returns (bool ok, uint256 word) {
        address to = diamond;
        uint256 gasCap = DIAMOND_VIEW_GAS;
        assembly ("memory-safe") {
            // Черновик за указателем свободной памяти: сам указатель не
            // двигаем, ничего долгоживущего здесь не остаётся. Селектор в
            // Yul лежит слева в слове, поэтому mstore + длина 4 дают ровно
            // четыре байта калладаты. Выходной буфер — тот же адрес: вход
            // прочитан до того, как EVM начнёт писать ответ.
            let ptr := mload(0x40)
            mstore(ptr, selector)
            ok := staticcall(gasCap, to, ptr, 4, ptr, 0x20)
            if lt(returndatasize(), 0x20) { ok := 0 }
            word := mload(ptr)
        }
        if (!ok) word = 0;
    }

    /// Пробует профинансировать банк на amount. Возвращает (ok, spent): ok —
    /// удался ли сам вызов диамонда, spent — сколько реально ушло с баланса
    /// казны (может быть меньше amount, если fundVault решит забрать не
    /// всё, и всегда 0, если !ok). Разрешение обнуляется в обоих случаях:
    /// при успехе fundVault мог забрать не всё, при провале (например,
    /// казну заменили через setFeeRecipient, и диамонд больше не пускает её
    /// в fundVault) оно осталось бы висеть бессрочно.
    ///
    /// Что делать с !ok, решает вызывающий, а не эта функция — и решают они
    /// по-разному. Сегодня вызывающих два: distribute() сознательно
    /// игнорирует ok и работает только со spent — провал банка не должен
    /// рушить фаундейшн и резерв. topUpVault(), напротив, !ok терпеть не
    /// может и честно ревертит: это явный разовый вызов, а не фоновая
    /// раздача, и резерв к этому моменту уже списан.
    ///
    /// Вызов диамонда сделан сырым CALL с нулевым выходным буфером — тот же
    /// приём, что и в MinimalForwarder.execute(): `.call(...)` на уровне
    /// Solidity всегда копирует ВЕСЬ returndata в память ещё до того, как
    /// код успевает его отбросить, независимо от того, что сам код потом
    /// делает с результатом (проверено ревью: диамонд с фасетом, чей
    /// fundVault ревертит мегабайтным payload, иначе замораживает
    /// distribute() газом — а владелец диамонда может смонтировать такой
    /// фасет через diamondCut в любой момент). Здесь возврат не нужен
    /// вообще, нужен только флаг успеха — выходной буфер нулевой длины,
    /// EVM не копирует ничего.
    function _fundVault(uint256 amount) private returns (bool ok, uint256 spent) {
        uint256 balanceBefore = IUSDC(usdc).balanceOf(address(this));
        if (!IUSDC(usdc).approve(diamond, amount)) revert ApproveFailed();

        address to = diamond;
        bytes memory payload = abi.encodeWithSelector(IHexsealDiamond.fundVault.selector, amount);
        assembly ("memory-safe") {
            ok := call(gas(), to, 0, add(payload, 0x20), mload(payload), 0, 0)
        }

        // Разрешение обнуляем независимо от исхода вызова выше.
        if (!IUSDC(usdc).approve(diamond, 0)) revert ApproveFailed();

        uint256 balanceAfter = IUSDC(usdc).balanceOf(address(this));
        // Если баланс не уменьшился (в т.ч. неожиданно вырос), считаем, что
        // ничего не потрачено — вычитание в обратную сторону дало бы Panic
        // 0x11 и обрушило бы всю раздачу.
        spent = balanceAfter < balanceBefore ? balanceBefore - balanceAfter : 0;
    }
}
