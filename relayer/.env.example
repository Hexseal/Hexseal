# ─────────────────────────────────────────────────────────────────────────────
# relayer/.env — шаблон
#
# Здесь перечислены ВСЕ переменные окружения, которые читает код релеера, и
# ничего сверх того. Список сверяется с кодом так:
#
#   cd relayer
#   { grep -ohE 'process\.env\.[A-Za-z_][A-Za-z0-9_]*' app.js bagPass.js \
#       bagStore.js directory.js index.js | sed 's/process\.env\.//';
#     grep -ohE "read(PositiveInt|Port)\('[A-Z_][A-Z0-9_]*'" app.js \
#       | sed -E "s/.*\('//; s/'//"; } | sort -u > /tmp/from-code
#   grep -oE '^[A-Z_]+=' .env.example | tr -d '=' | sort -u > /tmp/from-example
#   diff /tmp/from-code /tmp/from-example   # обязан быть пуст
#
# ⚠️ Значений здесь нет НИ У ОДНОЙ переменной, и это намеренно, а не лень:
# прежняя версия этого файла раздавала мёртвые адреса контрактов и настройки
# пиннинга, которого нет с мая 2026, — и была хуже своего отсутствия.
# Пустое значение везде означает «код возьмёт своё умолчание» (проверено:
# и `X || default`, и readPositiveInt() трактуют пустую строку именно так).
# Умолчание названо словами в комментарии над каждой строкой.
# ─────────────────────────────────────────────────────────────────────────────


# ══ Обязательное. Без этого сервер не поднимется или не сделает ничего ═══════

# Приватный ключ кошелька, который платит газ за мета-транзакции.
# Отдельный горячий кошелёк, НЕ кошелёк владельца. Держите на нём столько,
# сколько не жалко: он подписывает всё, что приходит на POST /relay.
RELAYER_PRIVATE_KEY=

# Адрес DiamondProxy. Умолчания нет.
DIAMOND_ADDRESS=

# Адрес MinimalForwarder — того же, что прописан в контрактах. Умолчания нет.
TRUSTED_FORWARDER=

# Общий секрет, которым релеер подписывает пропуска к чат-ящикам и файлам.
# Любая длинная случайная строка: `openssl rand -hex 32`. Умолчания нет —
# сервер откажется стартовать. Смена секрета обнуляет все выданные пропуска.
SERVER_SECRET=


# ══ Сеть и адреса ════════════════════════════════════════════════════════════

# RPC Base Sepolia. Читается первым; если пусто — берётся BASE_SEPOLIA_RPC_URL,
# если и он пуст — https://sepolia.base.org
RPC_URL=

# Запасное имя той же настройки (историческое). Умолчания нет.
BASE_SEPOLIA_RPC_URL=

# Терпение на один вызов RPC, мс. Умолчание 20000.
# 0, отрицательное и мусор ОТВЕРГАЮТСЯ при старте: нулевой таймаут ethers
# понимает как «ждать без конца», то есть ручка отменяла бы своё же лекарство.
RPC_TIMEOUT_MS=

# Адрес Treasury. Нужен только присмотру за казной; без него присмотр молчит.
TREASURY_ADDRESS=


# ══ HTTP ═════════════════════════════════════════════════════════════════════

# Порт. Умолчание 3001. Нечисловое значение отвергается при старте: Node принял
# бы его за путь к UNIX-сокету — сервер «поднялся бы», отрапортовал в журнал и
# был бы недоступен по TCP.
PORT=

# Через запятую: источники, которым разрешено обращаться к релееру.
# Умолчание http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=

# Свой публичный адрес — попадает в ссылки, которые релеер отдаёт наружу.
# Умолчание http://localhost:<PORT>
RELAYER_PUBLIC_URL=

# `true` — верить заголовку с IP клиента от обратного прокси. Умолчание false.
# ⚠️ Ставить `true` ТОЛЬКО когда перед релеером действительно стоит прокси,
# который этот заголовок перезаписывает. Иначе любой клиент назовётся любым IP
# и все ограничители по IP становятся украшением.
TRUST_PROXY=


# ══ Хранилище на диске ═══════════════════════════════════════════════════════

# Корень файлового хранилища. Умолчание — каталог `storage/` рядом с кодом.
# Внутри: постоянные публичные файлы, временные чат-файлы, ящики, справочник.
STORAGE_DIR=

# Сколько байт свободного места держать в запасе; ниже этого порога приём
# файлов отказывает ВЕЖЛИВО, вместо того чтобы упасть. Умолчание 2 ГиБ.
DISK_RESERVE_BYTES=


# ══ Уведомления в браузер (Web Push, VAPID) ══════════════════════════════════
# Пару ключей генерируют ОДИН раз:
#   node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();\
#     console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
# Открытую половину положить ещё и во фронт, как NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Без пары пуши просто не отправляются — сервер при этом работает.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Контакт для операторов push-служб, в форме `mailto:...`.
# ⚠️ Умолчание в коде указывает на несуществующий ящик — поставьте свой.
VAPID_EMAIL=

# Общий секрет между релеером и обработчиком /api/relay во фронте. Без него
# ончейн-пуши (Deal Funded/Activated/…) МОЛЧА не отправляются, а чат-пуши
# продолжают ходить — то есть поломка выглядит как «часть уведомлений пропала».
# Умолчания нет (пустая строка).
PUSH_SECRET=


# ══ Чат-ящики: сроки жизни и размеры ═════════════════════════════════════════
# Все сроки в миллисекундах. Негодное значение — громкий отказ при старте:
# тихий NaN здесь означал бы не «срок покороче», а «ничего не протухает вовсе».

# Обычный срок жизни мешка. Умолчание 7 суток.
BAG_TTL_MS=

# Срок жизни НЕПРОЧИТАННОГО мешка. Умолчание 30 суток.
BAG_UNREAD_TTL_MS=

# Жёсткий потолок возраста, после которого мешок удаляется в любом случае.
# Умолчание 90 суток.
BAG_MAX_AGE_MS=

# Отсрочка после закрытия сделки, в течение которой мешки ещё живут.
# Умолчание 1 сутки.
BAG_DEAL_GRACE_MS=

# Потолок размера одного мешка, байт. Умолчание 256 КиБ.
MAX_BAG_SIZE=

# Потолок журнала ящиков, байт. Умолчание 16 МиБ.
BAG_JOURNAL_MAX_BYTES=

# Допуск на расхождение часов клиента и сервера, мс. Умолчание 5 минут.
# 0 здесь законен и означает «никакого будущего не принимать вовсе».
CLOCK_SKEW_ALLOWANCE_MS=


# ══ Справочник ключей ════════════════════════════════════════════════════════

# Сколько прошлых ключей хранить на один адрес. Умолчание 200.
MAX_KEY_HISTORY=

# Потолок журнала справочника, байт. Умолчание 4 МиБ.
DIRECTORY_JOURNAL_MAX_BYTES=


# ══ Спор: доказательства и ящик ══════════════════════════════════════════════

# Срок жизни собранного доказательства спора, мс. Умолчание 60000.
DISPUTE_PROOF_TTL_MS=

# Длина цепочки доказательства, звеньев. Умолчание 120.
DISPUTE_PROOF_CHAIN_MAX=

# Пауза перед повтором сборки доказательства, мс. Умолчание 10000.
DISPUTE_RETRY_COOLDOWN_MS=

# Срок жизни набора доказательств, мс. Умолчание 15000.
DISPUTE_SET_TTL_MS=

# Ящик спора: срок жизни, мс. Умолчание 15000.
DISPUTE_BOX_TTL_MS=

# Ящик спора: пауза перед повтором, мс. Умолчание 10000.
DISPUTE_BOX_RETRY_COOLDOWN_MS=

# Ящик спора: длина цепочки, звеньев. Умолчание 90.
DISPUTE_BOX_CHAIN_MAX=


# ══ Ограничители частоты ═════════════════════════════════════════════════════
# Все — «сколько за минуту». Каждый отвергает 0, отрицательное и мусор при
# старте: битое значение здесь означает не «потолок поменьше», а «ограничителя
# нет вообще» (сравнение с NaN всегда ложно).

# Выпуск пропуска к ящику. Умолчание 30.
BAG_PASS_RATE_MAX=

# Выпуск пропуска с проверкой в цепи. Умолчание 12.
BAG_PASS_CHAIN_RATE_MAX=

# Чтение ящика. Умолчание 120.
BAG_READ_RATE_MAX=

# Запись в ящик. Умолчание 60.
BAG_WRITE_RATE_MAX=

# Общий потолок по IP на все обращения к ящикам. Умолчание 300.
BAG_IP_RATE_MAX=

# Запись в справочник ключей. Умолчание 20.
KEYS_WRITE_RATE_MAX=

# Обращения к справочнику по IP. Умолчание 120.
KEYS_IP_RATE_MAX=

# Отправка пушей. Умолчание 60.
PUSH_SEND_RATE_MAX=

# Отправка пушей по спору. Умолчание 120.
PUSH_DISPUTE_RATE_MAX=

# Запись в ящик спора. Умолчание 60.
DISPUTE_BOX_WRITE_RATE_MAX=

# Чтение ящика спора. Умолчание 120.
DISPUTE_BOX_READ_RATE_MAX=


# ══ Файлы чата ═══════════════════════════════════════════════════════════════

# Загрузки файлов на адрес. Умолчание 40.
CHAT_FILE_RATE_MAX=

# Загрузки файлов по IP. Умолчание 200.
CHAT_FILE_IP_RATE_MAX=

# Куски многокусочной заливки. Умолчание 600.
CHAT_FILE_PART_RATE_MAX=

# Потолок размера одного файла чата, байт. Умолчание 200 МиБ.
MAX_CHAT_FILE_SIZE=

# Терпение на одну проверку подписи контрактного кошелька, мс. Умолчание 5000.
# Отдельно от RPC_TIMEOUT_MS намеренно.
CONTRACT_SIG_TIMEOUT_MS=


# ══ Только для relayer/e2e.mjs ═══════════════════════════════════════════════
# ⚠️ Этот сценарий ходит в ЖИВУЮ Base Sepolia и тратит настоящий тестовый USDC.
# Он не входит в `npm test` и никогда не должен попасть в CI. Переменные ниже
# нужны только ему; серверу они не требуются.

# Адрес тестового USDC.
USDC_ADDRESS=

# Адрес запущенного релеера, к которому стучится сценарий.
RELAY_URL=

# Приватные ключи двух подставных сторон сделки. Одноразовые кошельки.
TEST_CLIENT_KEY=
TEST_EXECUTOR_KEY=
