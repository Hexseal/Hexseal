# ── Relayer wallet ────────────────────────────────────────────────────────────
# Private key of the wallet that pays gas for meta-transactions
RELAYER_PRIVATE_KEY=your_relayer_private_key

# ── RPC ───────────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org

# ── Contract addresses ────────────────────────────────────────────────────────
TRUSTED_FORWARDER=0x41c66b80B1445F48AF3863763BC0EC0549413CD7
DIAMOND_ADDRESS=0xF00CC71878c226E0b64253Fb71dD802aF12165D0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Dev:  ALLOWED_ORIGINS=http://localhost:3000
# Prod: ALLOWED_ORIGINS=https://signature404.com
ALLOWED_ORIGINS=http://localhost:3000

PORT=3001

# ── Storj S3 (encrypted file storage) ────────────────────────────────────────
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_ACCESS_KEY=your_storj_access_key
STORJ_SECRET_KEY=your_storj_secret_key
STORJ_BUCKET_FILES=s404-files

# ── Web Push / VAPID (browser push notifications) ─────────────────────────────
# Generate once:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
# Then copy VAPID_PUBLIC_KEY also to frontend/.env.local as NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@signature404.com
