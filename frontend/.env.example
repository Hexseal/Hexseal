# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local — шаблон. Скопируйте и заполните:
#
#   cp .env.example .env.local
#
# Здесь перечислены ВСЕ переменные окружения, которые читает код фронта, и
# ничего сверх того. Список сверяется с кодом так (из каталога frontend/):
#
#   git ls-files | grep -E '\.(ts|tsx|js|mjs|cjs)$' | grep -v '\.test\.' \
#     | grep -v '__stand__' \
#     | xargs grep -ohE 'process\.env\.[A-Za-z_][A-Za-z0-9_]*' \
#     | sed 's/process\.env\.//' | grep -vx 'NEXT_PUBLIC_' | sort -u > /tmp/from-code
#   grep -oE '^#? ?[A-Z_]+=' .env.example | tr -d '#= ' | sort -u > /tmp/from-example
#   diff /tmp/from-code /tmp/from-example   # обязан быть пуст
#
# (`NEXT_PUBLIC_` без имени в первом списке — это кусок комментария в
#  src/config/contracts.ts, а не чтение переменной.)
#
# ⚠️ НАСТОЯЩИХ ЗНАЧЕНИЙ ЗДЕСЬ НЕТ НИ ОДНОГО. Заполняйте своими.
#
# ⚠️ И ГЛАВНОЕ ПРО ФОРМУ: пустое значение здесь — это НЕ то же самое, что
# отсутствие переменной. Код фронта в большинстве мест пользуется `??`, а не
# `||`, и `??` пропускает пустую строку дальше как законное значение. То есть
#
#     NEXT_PUBLIC_RPC_URL=
#
# даёт не «умолчание https://sepolia.base.org», а пустой адрес RPC — и приложение
# идёт стучаться в никуда. Поэтому всё необязательное ниже ЗАКОММЕНТИРОВАНО:
# раскомментируйте строку только вместе со значением. Незакомментированными
# оставлены ровно три обязательные переменные — их отсутствие приложение назовёт
# вслух при загрузке (`requiredAddress`, src/config/contracts.ts).
# ─────────────────────────────────────────────────────────────────────────────


# ══ Обязательное: без этих трёх приложение не запустится ═════════════════════
# `src/config/contracts.ts` бросает НА ЗАГРУЗКЕ МОДУЛЯ, называя переменную.
# Умолчаний нет намеренно: однажды устаревший адрес, зашитый запасным
# вариантом, молча перебил исправленный.

# Адрес DiamondProxy.
NEXT_PUBLIC_DIAMOND_ADDRESS=

# Адрес MinimalForwarder.
NEXT_PUBLIC_FORWARDER_ADDRESS=

# Адрес тестового USDC.
NEXT_PUBLIC_USDC_ADDRESS=


# ══ Сеть ═════════════════════════════════════════════════════════════════════

# Идентификатор сети: 84532 — Base Sepolia, 8453 — Base mainnet. Умолчание —
# Base Sepolia. Ничего, кроме 8453, мейннетом не считается.
# NEXT_PUBLIC_CHAIN_ID=

# RPC, которым пользуется браузер. Умолчание https://sepolia.base.org
# NEXT_PUBLIC_RPC_URL=

# Запасное имя той же настройки (историческое): читается, если предыдущая пуста.
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=


# ══ Адреса, которые можно не задавать ════════════════════════════════════════

# Контракт квитанций о размещении работы. Умолчание — нулевой адрес.
# NEXT_PUBLIC_JOB_RECEIPT_ADDRESS=

# ⚠️ Мёртвая переменная: `next.config.ts` пробрасывает её в браузер, но её не
# читает НИ ОДНА строка приложения. Оставлена в шаблоне только чтобы список был
# полным; заполнять её незачем.
# NEXT_PUBLIC_HEXSEAL_ADDRESS=


# ══ Связь с релеером ═════════════════════════════════════════════════════════

# Адрес релеера, видимый из браузера. Умолчание http://localhost:3001
# NEXT_PUBLIC_RELAYER_URL=

# Адрес релеера изнутри сети (docker-compose, приватная сеть) — им пользуются
# обработчики /api/* на стороне сервера. Если не задан, они идут по публичному.
# RELAYER_INTERNAL_URL=

# Ещё два исторических имени того же адреса; читаются в /api/media и /api/push,
# если предыдущие пусты. Новые развёртывания их не задают.
# RELAYER_URL=
# RELAYER_PUBLIC_URL=


# ══ Кошелёк и уведомления ════════════════════════════════════════════════════

# Идентификатор проекта WalletConnect Cloud. Без него в списке кошельков
# остаются только встроенные в браузер.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ОТКРЫТАЯ половина VAPID-пары — та же, что VAPID_PUBLIC_KEY у релеера.
# Без неё подписка на пуши в браузере не оформляется.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ══ Только на сервере: в браузер не попадает ═════════════════════════════════
# Всё, что без префикса NEXT_PUBLIC_, читается только в обработчиках
# `src/app/api/*` и в next.config.ts. Такие значения не оказываются в бандле.

# Общий секрет с релеером — тот же, что PUSH_SECRET у него. Без него ончейн-пуши
# МОЛЧА не отправляются, а чат-пуши продолжают ходить: поломка выглядит как
# «часть уведомлений пропала», а не как ошибка.
# PUSH_SECRET=

# Приватный ключ для серверной подписи в /api/relay. Нужен, только если фронт
# сам подписывает мета-транзакции вместо релеера.
# ⚠️ Секрет. Не давайте ему префикса NEXT_PUBLIC_ — это выложило бы его в бандл.
# RELAYER_PRIVATE_KEY=

# Историческое имя того же ключа; читается, если предыдущее не задано.
# RELAY_PRIVATE_KEY=

# Прокси RPC (`/api/rpc`) выбирает первый непустой из трёх, в этом порядке.
# Смысл порядка: приватный/платный узел должен выигрывать у публичного.
# DRPC_URL=
# RPC_URL=
# BASE_SEPOLIA_RPC_URL=

# Через запятую: источники, которым прокси RPC разрешает обращаться к себе.
# ⚠️ Пустое значение = разрешено всем (fail-open). Задавайте явно.
# ALLOWED_ORIGINS=

# Адрес субграфа The Graph. Читается только на сервере; браузер ходит через
# /api/subgraph, чтобы адрес не уезжал в бандл.
# SUBGRAPH_URL=

# Номер сборки. Если не задан — берётся время сборки. Развёртывание обычно
# подставляет сюда хеш коммита.
# BUILD_ID=

# ⚠️ Руками НЕ задаётся: `next.config.ts` вычисляет её из BUILD_ID и сам кладёт
# в окружение браузера. В списке она потому, что код её читает.
# NEXT_PUBLIC_BUILD_ID=


# ══ Устаревшее ═══════════════════════════════════════════════════════════════

# Шлюз IPFS для ЧТЕНИЯ старых аватарок (`avatarCid`). Ничего нового в IPFS не
# кладётся с мая 2026 — файлы хранятся на собственном релеере.
# Умолчания зашиты в код и различаются по месту чтения.
# NEXT_PUBLIC_IPFS_GATEWAY=
