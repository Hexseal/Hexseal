# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
# `.env.example` — шаблон без единого настоящего значения, он ОБЯЗАН лежать в
# репозитории: README и CONTRIBUTING велят с него начинать. Заглушался строкой
# `.env.example` здесь, и `cp .env.example .env.local` упиралось в пустоту.
# Отрицание нужно потому, что `.env*` выше ловит его первым.
!.env.example
.env.relayer


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
