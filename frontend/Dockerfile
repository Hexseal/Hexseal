FROM node:22-alpine AS builder
WORKDIR /app

# NEXT_PUBLIC_* vars are baked in at build time
ARG NEXT_PUBLIC_RELAYER_URL
ARG NEXT_PUBLIC_DIAMOND_ADDRESS
ARG NEXT_PUBLIC_FORWARDER_ADDRESS
ARG NEXT_PUBLIC_USDC_ADDRESS
ARG NEXT_PUBLIC_JOB_RECEIPT_ADDRESS
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY
ARG NEXT_PUBLIC_IPFS_GATEWAY
ARG SUBGRAPH_URL

ENV NEXT_PUBLIC_RELAYER_URL=$NEXT_PUBLIC_RELAYER_URL
ENV NEXT_PUBLIC_DIAMOND_ADDRESS=$NEXT_PUBLIC_DIAMOND_ADDRESS
ENV NEXT_PUBLIC_FORWARDER_ADDRESS=$NEXT_PUBLIC_FORWARDER_ADDRESS
ENV NEXT_PUBLIC_USDC_ADDRESS=$NEXT_PUBLIC_USDC_ADDRESS
ENV NEXT_PUBLIC_JOB_RECEIPT_ADDRESS=$NEXT_PUBLIC_JOB_RECEIPT_ADDRESS
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=$NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY
ENV NEXT_PUBLIC_IPFS_GATEWAY=$NEXT_PUBLIC_IPFS_GATEWAY
ENV SUBGRAPH_URL=$SUBGRAPH_URL

COPY package*.json ./
RUN npm ci --legacy-peer-deps
# Cache-bust: the legacy Docker builder over-caches `COPY . .` on exFAT (flaky mtime),
# so source edits were silently building into a stale image. deploy-local.sh passes a
# changing CACHEBUST, which invalidates from here down (COPY + build) while keeping the
# slow `npm ci` above cached.
ARG CACHEBUST=0
COPY . .
RUN NODE_OPTIONS="--max-old-space-size=1536" npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
