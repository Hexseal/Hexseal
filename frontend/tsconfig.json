{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Тесты исключены из программы tsc намеренно. У фронта нет своего раннера и
  // поставить его нельзя (npm install тут падает на exFAT), поэтому vitest
  // берётся из ../relayer/node_modules — а этой папки НЕТ внутри Docker-образа:
  // он собирается с контекстом ./frontend. Пока тесты были в программе, сборка
  // держалась на недокументированном фильтре внутри Next, выбрасывающем
  // диагностику из файлов *.test.*. Переименование файла ломало бы прод.
  // Типы в тестах проверяются при запуске, `npm test` от этого исключения не
  // зависит: vitest свой API-модуль алиасит сам, без tsconfig-paths.
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
